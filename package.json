{
  "name": "contour",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @contour/web",
    "dev:desktop": "npm run dev --workspace @contour/desktop",
    "build:web": "npm run build --workspace @contour/web",
    "build:desktop": "npm run build --workspace @contour/desktop",
    "postinstall": "npm run generate --workspace @contour/db",
    "seed:db": "npm run seed --workspace @contour/db",
    "lint:web": "npm run lint --workspace @contour/web",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspace @contour/web",
    "typecheck:desktop": "npm run typecheck --workspace @contour/desktop"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "playwright": "^1.60.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
