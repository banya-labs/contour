{
  "name": "@contour/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron dist/main.js",
    "build": "tsup src/main.ts src/preload.ts --format esm --platform node --out-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "electron": "^31.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/electron": "^1.8.8",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
