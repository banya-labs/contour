generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// -----------------------------------------------------------------------------
// 1. Better Auth & Organization Multi-Tenancy
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  BROKER_MANAGER
  FIELD_AGENT
  FINANCE_OFFICER
  LANDLORD
  TENANT
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  role             UserRole @default(FIELD_AGENT)
  phone            String?
  twoFactorEnabled Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions                  Session[]
  accounts                  Account[]
  members                   Member[]
  apiKeys                   ApiKey[]
  twoFactor                 TwoFactor?
  assignedProperties        Property[]                  @relation("AssignedAgent")
  createdProperties         Property[]                  @relation("CreatedProperties")
  inquiries                 Inquiry[]                   @relation("AssignedInquiries")
  visits                    PropertyVisit[]
  transactions              Transaction[]               @relation("ClosingAgent")
  approvedStatements        LandlordStatement[]         @relation("ApprovedBy")
  vaultGrants               VaultAccessGrant[]          @relation("VaultGrants")
  grantedVaultAccess        VaultAccessGrant[]          @relation("GrantedVaultAccess")
  documentRequests          DocumentRequest[]
  sentInvitations           Invitation[]                @relation("InvitationInviter")
  managementCloseRequests   Inquiry[]                   @relation("ManagementCloseRequests")
  accessRequests            AccessRequest[]
  createdAccessRequestLinks AccessRequestLink[]         @relation("AccessRequestLinkCreator")
  createdBoundaries         PropertyBoundary[]          @relation("BoundaryCreatedBy")
  verifiedBoundaries        PropertyBoundary[]          @relation("BoundaryVerifiedBy")
  assignedTasks             FollowUpTask[]              @relation("AssignedTasks")
  matchNotifications        PropertyMatchNotification[]
  platformStaff             PlatformStaff?
  platformAuditEvents       PlatformAuditEvent[]        @relation("PlatformAuditActor")
  supportAccessSessions     SupportAccessSession[]      @relation("SupportAccessActor")
  grantedOrganizationOffers OrganizationOffer[]         @relation("OfferGrantActor")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  organizationId       String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  expiresAt             DateTime?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Required by Better Auth twoFactor() plugin — stores TOTP secret and backup codes.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Organization {
  id                    String                    @id @default(cuid())
  name                  String
  slug                  String                    @unique
  logo                  String?
  metadata              String?
  currency              Currency                  @default(ZMW)
  lencoCustomerId       String?
  lencoSubscriptionId   String?
  lencoAccountReference String?
  paystackCustomerId    String?
  paystackSubCode       String?
  subscriptionTier      String                    @default("STARTER") // STARTER, GROWTH, ENTERPRISE
  subscriptionStatus    String                    @default("active") // active, past_due, trialing
  trialEndsAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  accountStatus         OrganizationAccountStatus @default(ACTIVE)
  accountLockedAt       DateTime?
  accountLockReason     String?

  members                Member[]
  invitations            Invitation[]
  apiKeys                ApiKey[]
  properties             Property[]
  leases                 Lease[]
  rentPayments           RentPayment[]
  maintenanceExpenses    MaintenanceExpense[]
  landlordStatements     LandlordStatement[]
  arrearsReminders       RentArrearsReminder[]
  transactions           Transaction[]
  inquiries              Inquiry[]
  visits                 PropertyVisit[]
  auditLogs              AuditLog[]
  aiUsageLogs            AiUsageLog[]
  vaultDocuments         VaultDocument[]
  vaultAccessGrants      VaultAccessGrant[]
  documentRequests       DocumentRequest[]
  payments               Payment[]
  profile                OrganizationProfile?
  assets                 OrganizationAsset[]
  roles                  OrganizationRole[]
  uploadSessions         UploadSession[]
  accessRequestLink      AccessRequestLink?
  accessRequests         AccessRequest[]
  surveyExtractionJobs   SurveyExtractionJob[]
  boundaries             PropertyBoundary[]
  boundaryEvidenceEvents BoundaryEvidenceEvent[]
  followUpTasks          FollowUpTask[]
  matchNotifications     PropertyMatchNotification[]
  supportAccessSessions  SupportAccessSession[]      @relation("SupportAccessOrganization")
  organizationOffers     OrganizationOffer[]

  @@map("organization")
}

enum OrganizationAccountStatus {
  ACTIVE
  LOCKED
  SUSPENDED
  DELETION_PENDING
}

model Member {
  id                String    @id @default(cuid())
  organizationId    String
  userId            String
  role              String    @default("member")
  status            String    @default("active")
  deactivatedAt     DateTime?
  deactivatedById   String?
  lastRoleChangedAt DateTime?
  createdAt         DateTime  @default(now())

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments     MemberRoleAssignment[]
  permissionOverrides MemberPermissionOverride[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

enum PlatformStaffRole {
  OWNER
  OPERATIONS
  SUPPORT
  FINANCE
  COMPLIANCE
  READ_ONLY
}

enum PlatformStaffStatus {
  ACTIVE
  SUSPENDED
}

model PlatformStaff {
  id          String              @id @default(cuid())
  userId      String              @unique
  role        PlatformStaffRole   @default(READ_ONLY)
  status      PlatformStaffStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  suspendedAt DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEvents PlatformAuditEvent[] @relation("PlatformStaffActor")

  @@index([status, role])
  @@map("platform_staff")
}

model PlatformAuditEvent {
  id           String   @id @default(cuid())
  actorStaffId String?
  targetType   String
  targetId     String?
  capability   String
  reason       String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actorStaff  PlatformStaff? @relation("PlatformStaffActor", fields: [actorStaffId], references: [id], onDelete: SetNull)
  actorUser   User?          @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId String?

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("platform_audit_event")
}

model SupportAccessSession {
  id              String    @id @default(cuid())
  organizationId  String
  startedByUserId String
  reason          String
  mode            String    @default("VIEW_ONLY")
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation("SupportAccessOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  startedBy    User         @relation("SupportAccessActor", fields: [startedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, expiresAt])
  @@index([startedByUserId, createdAt])
  @@map("support_access_session")
}

enum PlatformOfferKind {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PlatformOfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

model PlatformOffer {
  id             String              @id @default(cuid())
  name           String
  code           String              @unique
  kind           PlatformOfferKind
  value          Decimal             @db.Decimal(12, 2)
  currency       Currency?
  status         PlatformOfferStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  redeemedCount  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  grants OrganizationOffer[]

  @@index([status, startsAt, endsAt])
  @@map("platform_offer")
}

model OrganizationOffer {
  id                String    @id @default(cuid())
  organizationId    String
  offerId           String
  grantedByUserId   String
  reason            String
  status            String    @default("ACTIVE")
  expiresAt         DateTime?
  reservedPaymentId String?   @unique
  reservedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offer        PlatformOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  grantedBy    User          @relation("OfferGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([offerId, status])
  @@map("organization_offer")
}

model Invitation {
  id               String    @id @default(cuid())
  organizationId   String
  inviterId        String?
  email            String
  role             String    @default("member")
  status           String    @default("pending")
  expiresAt        DateTime
  tokenHash        String?   @unique
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  roleKey          String?
  note             String?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)

  @@map("invitation")
}

model AccessRequestLink {
  id             String    @id @default(cuid())
  organizationId String    @unique
  tokenHash      String    @unique
  createdById    String
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AccessRequestLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("access_request_link")
}

model AccessRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  firstName      String
  lastName       String
  email          String
  roleKey        String    @default("FIELD_AGENT")
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  declineReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status, createdAt])
  @@map("access_request")
}

model OrganizationProfile {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  country              String    @default("ZM")
  timezone             String    @default("Africa/Lusaka")
  agencyType           String    @default("BROKERAGE")
  primaryOfficeAddress String?
  city                 String?
  primaryPhone         String?
  primaryEmail         String?
  onboardingStatus     String    @default("ORGANIZATION_PROFILE_REQUIRED")
  onboardingStep       String    @default("PROFILE")
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_profile")
}

model OrganizationAsset {
  id               String   @id @default(cuid())
  organizationId   String
  kind             String
  objectKey        String   @unique
  mimeType         String
  fileSize         Int
  sha256           String
  originalFileName String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind])
  @@index([organizationId, kind])
  @@map("organization_asset")
}

model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  displayName    String
  description    String?
  isSystem       Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  OrganizationRolePermission[]
  assignments  MemberRoleAssignment[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@map("organization_role")
}

model OrganizationRolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  role OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
  @@map("organization_role_permission")
}

model MemberRoleAssignment {
  id           String   @id @default(cuid())
  memberId     String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([memberId])
  @@map("member_role_assignment")
}

model MemberPermissionOverride {
  id           String   @id @default(cuid())
  memberId     String
  permission   String
  effect       String   @default("ALLOW")
  scope        Json?
  assignedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permission])
  @@index([memberId, effect])
  @@map("member_permission_override")
}

model UploadSession {
  id               String    @id @default(cuid())
  organizationId   String
  createdById      String?
  purpose          String
  objectKey        String    @unique
  expectedMimeType String
  expectedSize     Int
  expectedSha256   String?
  status           String    @default("PENDING")
  verifiedMimeType String?
  verifiedSize     Int?
  verifiedSha256   String?
  expiresAt        DateTime
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("upload_session")
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  key            String    @unique
  status         String    @default("active") // "active" | "revoked"
  permissions    String[]  @default(["read:properties", "write:inquiries"])
  lastUsedAt     DateTime?
  userId         String
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("api_key")
}

// -----------------------------------------------------------------------------
// 2. Core Real Estate Domain Models
// -----------------------------------------------------------------------------

enum Currency {
  ZMW
  USD
  ZAR
}

enum OwnershipType {
  COMPANY_OWNED
  MANAGED_ON_BEHALF
}

enum PropertyType {
  STANDALONE_HOUSE
  APARTMENT
  COMMERCIAL_OFFICE
  WAREHOUSE
  VACANT_LAND_PLOT
  FARM_AGRICULTURAL
}

enum ListingType {
  FOR_SALE
  FOR_RENT
  BOTH
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
  MAINTENANCE_HOLD
  DRAFT
  ARCHIVED
}

model Property {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  slug           String
  ownershipType  OwnershipType  @default(MANAGED_ON_BEHALF)
  propertyType   PropertyType   @default(STANDALONE_HOUSE)
  listingType    ListingType    @default(FOR_SALE)
  status         PropertyStatus @default(AVAILABLE)

  // Pricing
  askingPrice         Decimal? @db.Decimal(14, 2)
  rentalPrice         Decimal? @db.Decimal(14, 2)
  currency            Currency @default(ZMW)
  agencyCommissionPct Decimal  @default(5.0) @db.Decimal(5, 2) // e.g. 5% for sale, 10% for rent

  // Physical Specs
  bedrooms      Int?
  bathrooms     Decimal? @db.Decimal(3, 1)
  plotSizeSqm   Decimal? @db.Decimal(12, 2)
  description   String   @db.Text
  photos        String[] @default([])
  featuredPhoto String?

  // Geospatial & Landmarks (Crucial for Lusaka/Southern Africa)
  suburb             String // e.g. "Kabulonga", "Leopards Hill", "Woodlands"
  city               String  @default("Lusaka")
  latitude           Float?
  longitude          Float?
  standBoundary      Json? // Array of [lat, lng] coordinate pairs representing stand/plot boundary
  landmarkDirections String? @db.Text // e.g. "150m off Leopards Hill Rd opposite AIS"

  // Sensitive Landlord Info (Restricted by RBAC & Seams)
  ownerName        String?
  ownerPhone       String?
  ownerEmail       String?
  ownerBankDetails String? @db.Text
  titleDeedNumber  String?

  // Assignments & Metadata
  assignedAgentId            String?
  assignedAgentAt            DateTime?
  assignedAgentLockExpiresAt DateTime?
  createdById                String
  embedding                  Unsupported("vector(1536)")?
  matchingMetadata           Json?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAgent          User?                       @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  createdBy              User                        @relation("CreatedProperties", fields: [createdById], references: [id])
  leases                 Lease[]
  maintenanceExpenses    MaintenanceExpense[]
  transactions           Transaction[]
  visits                 PropertyVisit[]
  inquiries              Inquiry[]
  landlordStatements     LandlordStatement[]
  vaultDocuments         VaultDocument[]
  documentRequests       DocumentRequest[]
  surveyExtractionJobs   SurveyExtractionJob[]
  boundaries             PropertyBoundary[]
  boundaryEvidenceEvents BoundaryEvidenceEvent[]
  followUpTasks          FollowUpTask[]
  matchNotifications     PropertyMatchNotification[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, listingType])
  @@index([organizationId, suburb])
  @@index([organizationId, createdAt])
  @@index([assignedAgentId])
  @@index([assignedAgentLockExpiresAt])
  @@map("property")
}

// -----------------------------------------------------------------------------
// 3. Rental Management, Leases, Payments & Maintenance
// -----------------------------------------------------------------------------

model PropertyMatchNotification {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  inquiryId      String
  agentId        String?
  status         String    @default("UNREAD")
  title          String
  message        String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inquiry      Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([propertyId, inquiryId])
  @@index([organizationId, status, createdAt])
  @@index([agentId, status, createdAt])
  @@map("property_match_notification")
}

enum LeaseStatus {
  ACTIVE
  EXPIRING_SOON
  TERMINATED
  IN_ARREARS
}

model Lease {
  id                   String      @id @default(cuid())
  organizationId       String
  propertyId           String
  inquiryId            String?     @unique
  tenantName           String
  tenantPhone          String
  tenantEmail          String?
  tenantIdNumber       String? // NRC or Passport Number
  monthlyRent          Decimal     @db.Decimal(12, 2)
  currency             Currency    @default(ZMW)
  depositAmount        Decimal     @db.Decimal(12, 2)
  managementFeePercent Decimal     @default(10.0) @db.Decimal(5, 2) // Standard 10% property management fee
  leaseStartDate       DateTime
  leaseEndDate         DateTime
  paymentDayOfMonth    Int         @default(1)
  status               LeaseStatus @default(ACTIVE)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inquiry      Inquiry?              @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  payments     RentPayment[]
  reminders    RentArrearsReminder[]

  @@index([organizationId, status])
  @@index([propertyId])
  @@map("lease")
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY_AIRTEL
  MOBILE_MONEY_MTN
  CASH
  CHEQUE
}

enum PaymentStatus {
  CONFIRMED
  PENDING_VERIFICATION
  BOUNCED
}

model RentPayment {
  id              String        @id @default(cuid())
  organizationId  String
  leaseId         String
  amountPaid      Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(ZMW)
  periodMonth     Int // 1 to 12
  periodYear      Int // e.g. 2026
  paymentDate     DateTime
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  receiptNumber   String        @unique
  idempotencyKey  String?       @unique
  status          PaymentStatus @default(CONFIRMED)
  reconciledVia   String        @default("MANUAL") // "MANUAL", "MOMO_WEBHOOK", "BANK_OCR"
  rawPayload      String?       @db.Text
  notes           String?
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([organizationId, periodYear, periodMonth])
  @@map("rent_payment")
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  REJECTED
}

model MaintenanceExpense {
  id              String        @id @default(cuid())
  organizationId  String
  propertyId      String
  description     String
  vendorName      String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(ZMW)
  receiptPhotoUrl String?
  status          ExpenseStatus @default(APPROVED)
  periodMonth     Int // When this is deducted from landlord rent
  periodYear      Int
  createdAt       DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId, propertyId, periodYear, periodMonth])
  @@map("maintenance_expense")
}

enum StatementStatus {
  DRAFT
  APPROVED_BY_MANAGER
  SENT_TO_LANDLORD
  PAID_OUT
}

model LandlordStatement {
  id                    String          @id @default(cuid())
  organizationId        String
  propertyId            String
  landlordName          String
  statementMonth        Int
  statementYear         Int
  grossRentCollected    Decimal         @db.Decimal(12, 2)
  rentDue               Decimal         @default(0.0) @db.Decimal(12, 2)
  arrearsBroughtForward Decimal         @default(0.0) @db.Decimal(12, 2)
  arrearsClosing        Decimal         @default(0.0) @db.Decimal(12, 2)
  agencyFeeDeducted     Decimal         @db.Decimal(12, 2)
  maintenanceDeducted   Decimal         @default(0.0) @db.Decimal(12, 2)
  netLandlordPayout     Decimal         @db.Decimal(12, 2)
  currency              Currency        @default(ZMW)
  pdfUrl                String?
  status                StatementStatus @default(DRAFT)
  approvedById          String?
  approvedAt            DateTime?
  sentAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@unique([organizationId, propertyId, statementYear, statementMonth])
  @@index([organizationId, statementYear, statementMonth])
  @@index([organizationId, status])
  @@map("landlord_statement")
}

model RentArrearsReminder {
  id             String   @id @default(cuid())
  organizationId String
  leaseId        String
  tier           Int // 1 (Friendly), 2 (Urgent), 3 (Manager Escalation)
  channel        String   @default("WHATSAPP") // "WHATSAPP", "SMS", "EMAIL"
  recipientPhone String
  idempotencyKey String   @unique // e.g. "arrears-lease123-2026-8-tier1"
  status         String   @default("SENT") // "SENT", "DELIVERED", "FAILED"
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([organizationId, leaseId])
  @@map("rent_arrears_reminder")
}

// -----------------------------------------------------------------------------
// 4. Commission Splits & Transactions
// -----------------------------------------------------------------------------

enum TransactionType {
  PROPERTY_SALE
  RENTAL_PLACEMENT
}

enum CommissionStatus {
  EXPECTED
  EARNED
  PARTIALLY_RECEIVED
  RECEIVED
  AGENT_PAID_OUT
}

model Transaction {
  id                     String           @id @default(cuid())
  organizationId         String
  propertyId             String
  transactionType        TransactionType  @default(PROPERTY_SALE)
  grossValue             Decimal          @db.Decimal(14, 2) // Total sale/lease value
  currency               Currency         @default(ZMW)
  agencyCommissionPct    Decimal          @db.Decimal(5, 2) // e.g. 5%
  agencyCommissionAmount Decimal          @db.Decimal(12, 2) // e.g. K100,000
  agentSplitPct          Decimal          @default(50.0) @db.Decimal(5, 2) // e.g. 50% to closing agent
  agentSplitAmount       Decimal          @db.Decimal(12, 2) // e.g. K50,000
  status                 CommissionStatus @default(EXPECTED)
  closingAgentId         String
  inquiryId              String?          @unique
  closedAt               DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  closingAgent User         @relation("ClosingAgent", fields: [closingAgentId], references: [id])
  inquiry      Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([propertyId])
  @@index([closingAgentId])
  @@map("transaction")
}

// -----------------------------------------------------------------------------
// 5. CRM Inquiries & Field Visits
// -----------------------------------------------------------------------------

enum InquiryStatus {
  NEW_INQUIRY
  CONTACTED
  QUALIFIED
  VIEWING_SCHEDULED
  VIEWING_OR_OFFER
  NEGOTIATING
  OFFER_MADE
  MANAGEMENT_HANDOVER
  VERIFICATION_CLOSING
  CLOSED
  CLOSED_WON
  CLOSED_LOST
}

enum PipelineOutcome {
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  CLIENT_REFERRAL
  WALK_IN
  SOCIAL_MEDIA
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  PROPERTY_PORTAL
  PHONE
  OTHER
}

model Inquiry {
  id                           String           @id @default(cuid())
  organizationId               String
  clientName                   String
  clientPhone                  String
  clientEmail                  String?
  lookingFor                   ListingType      @default(FOR_SALE)
  propertyType                 PropertyType?
  budgetMin                    Decimal?         @db.Decimal(12, 2)
  budgetMax                    Decimal?         @db.Decimal(12, 2)
  currency                     Currency         @default(ZMW)
  preferredSuburbs             String[]         @default([])
  notes                        String?          @db.Text
  status                       InquiryStatus    @default(NEW_INQUIRY)
  assignedAgentId              String?
  outcome                      PipelineOutcome?
  lostReason                   String?          @db.Text
  closedAt                     DateTime?
  closedById                   String?
  managementCloseRequestedAt   DateTime?
  managementCloseRequestedById String?
  leadSource                   LeadSource       @default(OTHER)
  propertyId                   String?
  dealValue                    Decimal?         @db.Decimal(14, 2)
  exclusiveLockExpiresAt       DateTime? // 30-day anti-poaching lock
  matchStatus                  MatchStatus      @default(UNMATCHED)
  unmatchedReason              String? // NO_SUITABLE_PROPERTY, BUDGET_MISMATCH, LOCATION_UNAVAILABLE, CLIENT_TIMING, OTHER
  matchingProfile              Json?
  failedAtStage                String? // VIEWING, NEGOTIATION, OFFER -- only set on CLOSED/LOST
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAgent              User?                       @relation("AssignedInquiries", fields: [assignedAgentId], references: [id])
  managementCloseRequestedBy User?                       @relation("ManagementCloseRequests", fields: [managementCloseRequestedById], references: [id])
  property                   Property?                   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  visits                     PropertyVisit[]
  documentRequests           DocumentRequest[]
  followUpTasks              FollowUpTask[]
  matchNotifications         PropertyMatchNotification[]
  lease                      Lease?
  transactions               Transaction[]
  idempotencyKey             String?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, leadSource])
  @@index([propertyId])
  @@index([organizationId, createdAt])
  @@index([assignedAgentId])
  @@map("inquiry")
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model PropertyVisit {
  id             String      @id @default(cuid())
  organizationId String
  propertyId     String
  inquiryId      String
  agentId        String
  scheduledAt    DateTime
  status         VisitStatus @default(SCHEDULED)
  clientFeedback String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inquiry      Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id])

  @@index([organizationId, scheduledAt])
  @@map("property_visit")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
}

model FollowUpTask {
  id             String       @id @default(cuid())
  organizationId String
  assignedUserId String
  inquiryId      String?
  propertyId     String?
  title          String
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  dueDate        DateTime
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User         @relation("AssignedTasks", fields: [assignedUserId], references: [id], onDelete: Cascade)
  inquiry      Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, dueDate])
  @@map("follow_up_task")
}

// -----------------------------------------------------------------------------
// 6. Security, POPIA Audit & Token Telemetry
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // e.g. "VIEW_LANDLORD_BANK_DETAILS", "EXPORT_TENANT_DATA", "AUTHORIZE_REMITTANCE"
  entityType     String // "Property", "Lease", "LandlordStatement"
  entityId       String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

model AiUsageLog {
  id               String   @id @default(cuid())
  organizationId   String
  userId           String?
  agentType        String // "WHATSAPP_LISTING_INGESTION", "MATCHMAKER", "ARREARS_SENTRY"
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostZar Decimal  @db.Decimal(8, 4)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_usage_log")
}

// -----------------------------------------------------------------------------
// 7. Document Vault — MinIO Object Storage Bridge
// Each record in Neon points to a file stored in MinIO via objectKey.
// Presigned download URLs are generated on-demand by /api/storage/[fileId].
// -----------------------------------------------------------------------------

enum DocumentType {
  TITLE_DEED
  NRC_PASSPORT_ID
  MANDATE_AGREEMENT
  LEASE_CONTRACT
  SITE_SURVEY_DIAGRAM
  PACRA_CERTIFICATE
  VALUATION_REPORT
  PROOF_OF_RESIDENCE
  PAYMENT_RECEIPT
  CLIENT_CORRESPONDENCE
  OTHER
}

enum SecurityLevel {
  RESTRICTED_MANAGEMENT
  CONFIDENTIAL_PII
  AGENT_ACCESSIBLE
}

enum VaultAccessLevel {
  FULL_VAULT
  ASSIGNED_ONLY
  SPECIFIC_FOLDERS
}

enum DocumentRequestStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  EXPIRED
  REVOKED
}

enum LencoPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id                    String             @id @default(cuid())
  organizationId        String
  reference             String             @unique
  idempotencyKey        String             @unique
  provider              String             @default("LENCO")
  providerTransactionId String?
  planId                String
  billingCycle          String
  amount                Decimal            @db.Decimal(12, 2)
  currency              Currency
  status                LencoPaymentStatus @default(PENDING)
  failureReason         String?
  checkoutUrl           String?
  metadata              Json?
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("payment")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  dedupeKey   String    @unique
  eventId     String?
  eventType   String
  reference   String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, reference])
  @@index([provider, createdAt])
  @@map("webhook_event")
}

model VaultDocument {
  id             String  @id @default(cuid())
  organizationId String
  propertyId     String?

  // Document identity
  title          String
  description    String?       @db.Text
  docType        DocumentType  @default(TITLE_DEED)
  classification SecurityLevel @default(RESTRICTED_MANAGEMENT)

  // MinIO / S3 pointer — the objectKey is the full bucket path
  // e.g. "org_contour_demo/title_deed/1721234567890_deed.pdf"
  objectKey        String @unique
  originalFileName String
  fileSize         Int // bytes
  mimeType         String
  fileType         String // "PDF", "JPG", "PNG", etc.

  // Zambian land registry metadata (Lands & Deeds Registry Act Cap 185)
  registryFolio   String?
  standPlotNumber String?
  nrcNumber       String?

  // Ingestion Source & Client Request Bridge
  uploadedBy        String // Display name or reference
  uploadedByType    String  @default("STAFF") // "STAFF" | "CLIENT" | "SYSTEM"
  uploadedById      String? // User ID if STAFF
  documentRequestId String? // Linked DocumentRequest if CLIENT

  // Audit & Verification
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  verifiedById   String?
  sha256Checksum String?

  // Soft-Delete / Archival Guardrail
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property             Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  documentRequest      DocumentRequest?      @relation(fields: [documentRequestId], references: [id], onDelete: SetNull)
  surveyExtractionJobs SurveyExtractionJob[]
  boundaries           PropertyBoundary[]

  @@index([organizationId, docType])
  @@index([organizationId, propertyId])
  @@index([organizationId, isDeleted])
  @@index([organizationId, createdAt])
  @@map("vault_document")
}

model SurveyExtractionJob {
  id               String    @id @default(cuid())
  organizationId   String
  propertyId       String
  sourceDocumentId String
  idempotencyKey   String?
  status           String    @default("QUEUED")
  engine           String?
  engineVersion    String?
  pageCount        Int?
  processedPages   Int       @default(0)
  rawOcrObjectKey  String?
  extractionJson   Json?
  errorCode        String?
  errorMessage     String?
  createdById      String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceDocument VaultDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, propertyId])
  @@index([sourceDocumentId])
  @@map("survey_extraction_job")
}

enum PropertyBoundarySourceType {
  TITLE_DEED
  GOVERNMENT_CADASTRE
  GEOJSON
  KML
  SHAPEFILE
  AGENT_DRAWN
}

enum PropertyBoundaryStatus {
  PENDING
  MATCHED
  VERIFIED
  REJECTED
  SUPERSEDED
}

model PropertyBoundary {
  id                  String                     @id @default(cuid())
  organizationId      String
  propertyId          String
  sourceType          PropertyBoundarySourceType
  status              PropertyBoundaryStatus     @default(PENDING)
  geometryGeoJson     Json
  sourceCrs           String?
  targetCrs           String                     @default("EPSG:4326")
  plotId              String?
  surveyReference     String?
  diagramNumber       String?
  planNumber          String?
  statedAreaSqm       Decimal?                   @db.Decimal(14, 3)
  calculatedAreaSqm   Decimal?                   @db.Decimal(14, 3)
  areaDifferencePct   Decimal?                   @db.Decimal(8, 3)
  sourceDocumentId    String?
  governmentSourceUrl String?
  governmentLayer     String?
  governmentRecordId  String?
  governmentFetchedAt DateTime?
  confidenceScore     Decimal?                   @db.Decimal(5, 4)
  validationFlags     Json                       @default("[]")
  createdById         String
  verifiedById        String?
  verifiedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceDocument VaultDocument?          @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdBy      User                    @relation("BoundaryCreatedBy", fields: [createdById], references: [id])
  verifiedBy     User?                   @relation("BoundaryVerifiedBy", fields: [verifiedById], references: [id])
  evidenceEvents BoundaryEvidenceEvent[]

  @@index([organizationId, propertyId, status])
  @@index([sourceDocumentId])
  @@map("property_boundary")
}

model BoundaryEvidenceEvent {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  boundaryId     String?
  eventType      String
  actorId        String?
  details        Json?
  sourceHash     String?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  boundary     PropertyBoundary? @relation(fields: [boundaryId], references: [id], onDelete: SetNull)

  @@index([organizationId, propertyId, createdAt])
  @@index([boundaryId, createdAt])
  @@map("boundary_evidence_event")
}

model VaultAccessGrant {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  accessLevel    VaultAccessLevel @default(ASSIGNED_ONLY)
  propertyIds    String[]         @default([]) // Whitelisted IDs when accessLevel = SPECIFIC_FOLDERS
  canVerifyDocs  Boolean          @default(false)
  canDeleteDocs  Boolean          @default(false)
  grantedById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("VaultGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("GrantedVaultAccess", fields: [grantedById], references: [id])

  @@unique([organizationId, userId])
  @@map("vault_access_grant")
}

model DocumentRequest {
  id             String  @id @default(cuid())
  organizationId String
  propertyId     String?
  inquiryId      String?
  requestedById  String

  title            String
  message          String?        @db.Text
  requiredTypes    DocumentType[] @default([NRC_PASSPORT_ID])
  maxFiles         Int            @default(5)
  maxSizeMbPerFile Int            @default(15)

  token     String                @unique
  pinHash   String?
  expiresAt DateTime
  status    DocumentRequestStatus @default(PENDING)

  // Zambia DPA Art. 21 Explicit Consent Record
  clientName       String?
  clientPhone      String?
  clientEmail      String?
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  consentIp        String?
  consentUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  inquiry      Inquiry?        @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  requestedBy  User            @relation(fields: [requestedById], references: [id])
  documents    VaultDocument[]

  @@index([token])
  @@index([organizationId, status])
  @@map("document_request")
}
