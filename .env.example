# Next.js App / Dev Config
NEXT_PUBLIC_DEV_MODE="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis Config (Layer 9 Rate Limiting & Layer 10 Cache-Aside)
# Optional in local dev (falls back to in-memory sliding window)
REDIS_URL="redis://localhost:6379"
POWERSYNC_URL="http://localhost:8080"
# Use a separate 32+ character secret in deployed environments.
POWERSYNC_JWT_SECRET="change-this-to-a-separate-32-character-secret"

# Database & Auth Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contour
BETTER_AUTH_SECRET="contour-secret-key-change-in-prod"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional separate master secret for Dify background agent bearer auth
DIFY_MASTER_SECRET=""

# Lenco Zambia billing
LENCO_API_KEY=""
LENCO_API_URL="https://api.lenco.co/access/v2"
LENCO_ENVIRONMENT="sandbox"

# Application runtime
S3_REGION="auto"
S3_PUBLIC_DOMAIN=""
NODE_ENV="development"
NEXT_PUBLIC_MAP_DEFAULT_LAT="-15.4167"
NEXT_PUBLIC_MAP_DEFAULT_LNG="28.2833"
SKIP_ENV_VALIDATION="false"

# MinIO S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_NAME="contour-vault"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# OpenRouter AI (Executive Report Synthesis)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
